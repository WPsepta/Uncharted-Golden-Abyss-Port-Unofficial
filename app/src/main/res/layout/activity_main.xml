<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top bar: GitHub logo + account -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/btnGithub"
                android:layout_width="40dp" android:layout_height="40dp"
                android:src="@drawable/ic_github"
                android:contentDescription="GitHub — buka repositori"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="WPsepta"
                android:textColor="@color/text"
                android:textStyle="bold"
                android:textSize="16sp" />
            <TextView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="v0.1.0"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Title block -->
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/title"
            android:textColor="@color/gold"
            android:textStyle="bold"
            android:textSize="26sp" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/subtitle"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <!-- Asset folder picker (pilih folder aset game milik sendiri) -->
        <Button
            android:id="@+id/btnPickAssets"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="Pilih Folder Aset Game"
            android:textColor="@color/text"
            android:backgroundTint="@color/panel_light"
            android:stateListAnimator="@null" />
        <TextView
            android:id="@+id/tvAssetStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Folder aset belum dipilih"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <!-- Start button -->
        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent" android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:text="@string/start_game"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/ink"
            android:backgroundTint="@color/gold"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnLog"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/read_log"
            android:textColor="@color/text"
            android:backgroundTint="@color/panel_light"
            android:stateListAnimator="@null" />

        <!-- Settings 1: Performance -->
        <TextView
            android:layout_marginTop="28dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Performance"
            android:textColor="@color/gold" android:textStyle="bold" android:textSize="16sp" />
        <LinearLayout android:orientation="horizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@color/panel" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_vertical" android:text="FPS" android:textColor="@color/text" />
            <RadioGroup android:id="@+id/rgFps"
                android:orientation="horizontal" android:layout_marginStart="12dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content">
                <RadioButton android:id="@+id/fps30" android:text="30" android:textColor="@color/text" android:checked="true" />
                <RadioButton android:id="@+id/fps60" android:text="60" android:textColor="@color/text" />
                <RadioButton android:id="@+id/fpsUnlimited" android:text="∞" android:textColor="@color/text" />
            </RadioGroup>
        </LinearLayout>

        <!-- Settings 2: Controls -->
        <TextView
            android:layout_marginTop="20dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Controls"
            android:textColor="@color/gold" android:textStyle="bold" android:textSize="16sp" />
        <Spinner android:id="@+id/spTouchPreset"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/panel" />
        <SeekBar android:id="@+id/sbSensitivity"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:max="100" android:progress="50"
            android:progressTint="@color/gold" />

        <!-- Settings 3: System -->
        <TextView
            android:layout_marginTop="20dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="System"
            android:textColor="@color/gold" android:textStyle="bold" android:textSize="16sp" />
        <LinearLayout android:orientation="horizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@color/panel" android:padding="12dp">
            <Switch android:id="@+id/swShowFps"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Tampilkan FPS di game" android:textColor="@color/text" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@color/panel" android:padding="12dp">
            <Switch android:id="@+id/swVSync"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="VSync" android:textColor="@color/text" android:checked="true" />
        </LinearLayout>

        <!-- Legal footer -->
        <TextView
            android:layout_marginTop="24dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/legal_short"
            android:textColor="@color/text_dim" android:textSize="10sp"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>

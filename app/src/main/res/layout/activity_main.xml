<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Judul atas -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="UNCHARTED: GOLDEN ABYSS"
            android:textColor="@color/gold"
            android:textStyle="bold"
            android:textSize="20sp"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp" />

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Tombol menu vertikal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Mulai + kotak kecil ubah folder -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <Button
                    android:id="@+id/btnStart"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="4"
                    android:text="Mulai"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink"
                    android:backgroundTint="@color/gold"
                    android:drawableLeft="@android:drawable/ic_media_play"
                    android:drawablePadding="8dp"
                    android:stateListAnimator="@null" />
                <Button
                    android:id="@+id/btnPickAssets"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:text="📁"
                    android:textSize="20sp"
                    android:textColor="@color/text"
                    android:backgroundTint="@color/panel_light"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAssetStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Folder aset belum dipilih"
                android:textColor="@color/text_dim"
                android:textSize="10sp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="Pengaturan"
                android:textSize="14sp"
                android:textColor="@color/text"
                android:backgroundTint="@color/panel_light"
                android:drawableLeft="@android:drawable/ic_menu_preferences"
                android:drawablePadding="8dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnAbout"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:text="Tentang"
                android:textSize="14sp"
                android:textColor="@color/text"
                android:backgroundTint="@color/panel_light"
                android:drawableLeft="@android:drawable/ic_menu_info_details"
                android:drawablePadding="8dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnExit"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:text="Keluar"
                android:textSize="14sp"
                android:textColor="@color/text"
                android:backgroundTint="@color/panel_light"
                android:drawableLeft="@android:drawable/ic_menu_close_clear_cancel"
                android:drawablePadding="8dp"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/legal_short"
            android:textColor="@color/text_dim"
            android:textSize="8sp"
            android:gravity="center"
            android:layout_marginBottom="4dp" />
    </LinearLayout>

    <!-- WebView untuk baru.html launcher (tampilkan UI dari assets) -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <!-- GitHub logo moved to uncharted.html (controlled by JS) -->
</FrameLayout>
<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- Title: tengah atas -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Uncharted: Golden Abyss"
            android:textColor="@color/gold"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp" />

        <!-- Pilih folder aset -->
        <Button
            android:id="@+id/btnPickAssets"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:text="Pilih Folder Aset Game"
            android:textSize="12sp"
            android:textColor="@color/text"
            android:backgroundTint="@color/panel_light"
            android:stateListAnimator="@null" />
        <TextView
            android:id="@+id/tvAssetStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Folder aset belum dipilih"
            android:textColor="@color/text_dim"
            android:textSize="10sp" />

        <!-- Mulai + Log -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="2"
                android:text="@string/start_game"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ink"
                android:backgroundTint="@color/gold"
                android:stateListAnimator="@null" />
            <Button
                android:id="@+id/btnLog"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/read_log"
                android:textSize="11sp"
                android:textColor="@color/text"
                android:backgroundTint="@color/panel_light"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- Performance -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Performance"
            android:textColor="@color/gold"
            android:textStyle="bold"
            android:textSize="12sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:background="@color/panel"
            android:padding="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="FPS"
                android:textSize="11sp"
                android:textColor="@color/text" />
            <RadioGroup
                android:id="@+id/rgFps"
                android:orientation="horizontal"
                android:layout_marginStart="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/fps30"
                    android:text="30"
                    android:textSize="11sp"
                    android:textColor="@color/text"
                    android:checked="true" />
                <RadioButton
                    android:id="@+id/fps60"
                    android:text="60"
                    android:textSize="11sp"
                    android:textColor="@color/text" />
                <RadioButton
                    android:id="@+id/fpsUnlimited"
                    android:text="∞"
                    android:textSize="11sp"
                    android:textColor="@color/text" />
            </RadioGroup>
        </LinearLayout>

        <!-- Controls -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Controls"
            android:textColor="@color/gold"
            android:textStyle="bold"
            android:textSize="12sp" />
        <Spinner
            android:id="@+id/spTouchPreset"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="2dp"
            android:backgroundTint="@color/panel" />
        <SeekBar
            android:id="@+id/sbSensitivity"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="2dp"
            android:max="100"
            android:progress="50"
            android:progressTint="@color/gold" />

        <!-- System -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="System"
            android:textColor="@color/gold"
            android:textStyle="bold"
            android:textSize="12sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:background="@color/panel"
            android:padding="4dp">
            <Switch
                android:id="@+id/swShowFps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FPS Overlay"
                android:textSize="11sp"
                android:textColor="@color/text" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:background="@color/panel"
            android:padding="4dp">
            <Switch
                android:id="@+id/swVSync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VSync"
                android:textSize="11sp"
                android:textColor="@color/text"
                android:checked="true" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/legal_short"
            android:textColor="@color/text_dim"
            android:textSize="8sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- GitHub logo: pojok kanan bawah -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp">
        <ImageView
            android:id="@+id/btnGithub"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_github"
            android:contentDescription="GitHub — buka repositori"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="WPsepta"
            android:textColor="@color/text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>